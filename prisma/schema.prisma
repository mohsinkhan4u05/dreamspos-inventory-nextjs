// DreamsPOS Database Schema
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        String     @id @default(cuid())
  email     String     @unique
  username  String?    @unique
  password  String?
  firstName String?
  lastName  String?
  phone     String?
  roleId    String? // New granular role system
  avatar    String?
  status    UserStatus @default(PENDING)
  isActive  Boolean    @default(true)
  invitedAt DateTime?
  joinedAt  DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  posSessions             POSSession[]
  stockAdjustments        StockAdjustment[]
  customRole              Role?             @relation(fields: [roleId], references: [id])
  auditLogs               AuditLog[]
  invitationsSent         UserInvitation[]  @relation("InvitedBy")
  productionOrdersCreated ProductionOrder[]
  productsCreated         Product[]         @relation("ProductCreatedBy")

  @@map("users")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

// User Invitation Management
model UserInvitation {
  id          String           @id @default(cuid())
  email       String
  firstName   String?
  lastName    String?
  roleId      String
  token       String           @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  status      InvitationStatus @default(PENDING)
  invitedById String
  createdAt   DateTime         @default(now())

  // Relations
  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])
  role      Role @relation(fields: [roleId], references: [id])

  @@unique([email, status])
  @@index([token])
  @@index([email])
  @@map("user_invitations")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Password Update OTP
model PasswordUpdateOTP {
  id        String   @id @default(cuid())
  userId    String
  adminId   String
  otpHash   String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, verified])
  @@index([expiresAt])
  @@map("password_update_otps")
}

// Store Management
model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stocks            Stock[]
  stockMovements    StockMovement[]
  posSessions       POSSession[]
  sales             Sale[]
  purchases         Purchase[]
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]
  stockAdjustments  StockAdjustment[]
  stockLayers       StockLayer[]      @relation("StoreStockLayers")
  packages          Package[]
  shipments         Shipment[]
  purchaseReceives  PurchaseReceive[]
  accountingEntries AccountingEntry[]
  productionOrders  ProductionOrder[]

  @@map("stores")
}

// Warehouse Management
model Warehouse {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  workPhone     String?
  email         String?
  address1      String?
  address2      String?
  country       String?
  state         String?
  city          String?
  zipcode       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  stocks         Stock[]
  stockMovements StockMovement[]
  stockLayers    StockLayer[]    @relation("WarehouseStockLayers")

  @@map("warehouses")
}

// Category Management
model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  @@map("categories")
}

// Brand Management
model Brand {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]

  @@map("brands")
}

// Unit Management
model Unit {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products        ProductUnit[]
  primaryProducts Product[]        @relation("PrimaryUnit")
  stockMovements  StockMovement[]
  stocks          Stock[]
  billOfMaterials BillOfMaterial[]

  @@map("units")
}

enum ItemType {
  GOODS
  SERVICE
  RAW_MATERIAL
  FINISHED_GOOD
  CONSUMABLE
}

enum InventoryValuationMethod {
  FIFO
}

enum BatchStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  DEPLETED
}

enum BatchSourceType {
  OPENING_STOCK
  PURCHASE
  MANUFACTURING
  SALES_RETURN
  ADJUSTMENT
}

// Product Management
model Product {
  id                    String                   @id @default(cuid())
  name                  String
  description           String?
  sku                   String?
  barcode               String?                  @unique
  brandId               String?
  createdByUserId       String?
  image                 String?
  costPrice             Float
  sellingPrice          Float
  minPrice              Float?
  maxPrice              Float?
  reorderLevel          Float                    @default(0)
  reorderQty            Float                    @default(0)
  isActive              Boolean                  @default(true)
  itemType              ItemType                 @default(GOODS)
  unitId                String?
  returnable            Boolean                  @default(false)
  length                Float?
  width                 Float?
  height                Float?
  dimensionUnit         String?
  weight                Float?
  weightUnit            String?
  manufacturer          String?
  upc                   String?
  ean                   String?
  mpn                   String?
  isbn                  String?
  sellable              Boolean                  @default(true)
  purchasable           Boolean                  @default(true)
  salesDescription      String?
  purchaseDescription   String?
  preferredVendorId     String?
  salesAccount          String?
  purchaseAccount       String?
  inventoryAccount      String?
  inventoryValuation    InventoryValuationMethod @default(FIFO)
  trackInventory        Boolean                  @default(true)
  openingStock          Float?
  openingStockRate      Float?
  allowOpeningStockEdit Boolean                  @default(true)
  isVariant             Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  // Relations
  brand                  Brand?                  @relation(fields: [brandId], references: [id])
  unit                   Unit?                   @relation("PrimaryUnit", fields: [unitId], references: [id])
  preferredVendor        Supplier?               @relation("SupplierProducts", fields: [preferredVendorId], references: [id])
  createdBy              User?                   @relation("ProductCreatedBy", fields: [createdByUserId], references: [id])
  variants               ProductVariant[]
  options                ProductOption[]
  units                  ProductUnit[]
  stocks                 Stock[]
  stockMovements         StockMovement[]
  stockLayers            StockLayer[]            @relation("ProductStockLayers")
  gstRates               ProductGST[]
  batches                ItemBatch[]
  saleItems              SaleItem[]
  salesOrderItems        SalesOrderItem[]
  purchaseItems          PurchaseItem[]
  purchaseOrderItems     PurchaseOrderItem[]
  returnItems            ReturnItem[]
  stockAdjustments       StockAdjustment[]
  packageItems           PackageItem[]
  shipmentItems          ShipmentItem[]
  purchaseReceiveItems   PurchaseReceiveItem[]
  bomAsParent            BillOfMaterial[]        @relation("BOMParent")
  bomAsChild             BillOfMaterial[]        @relation("BOMChild")
  productionOrders       ProductionOrder[]
  productionConsumptions ProductionConsumption[]

  @@map("products")
}

model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int

  // Relations
  values  ProductOptionValue[]
  product Product              @relation(fields: [productId], references: [id])

  @@unique([productId, name])
  @@map("product_options")
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String // 10 gms, 20 gms

  // Relations
  option ProductOption @relation(fields: [optionId], references: [id])

  @@unique([optionId, value])
  @@map("product_option_values")
}

model ItemBatch {
  id                String          @id @default(cuid())
  productId         String
  variantId         String?
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  unitCost          Float
  openingQuantity   Float
  availableQuantity Float
  reservedQuantity  Float           @default(0)
  status            BatchStatus     @default(ACTIVE)
  sourceType        BatchSourceType
  referenceId       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant              ProductVariant?       @relation(fields: [variantId], references: [id])
  stockMovements       StockMovement[]
  saleItems            SaleItem[]
  salesOrderItems      SalesOrderItem[]
  purchaseItems        PurchaseItem[]
  purchaseReceiveItems PurchaseReceiveItem[]

  @@unique([productId, batchNumber])
  @@index([variantId])
  @@map("item_batches")
}

// Product Variants
model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  name         String
  sku          String?
  barcode      String?  @unique
  costPrice    Float?
  sellingPrice Float?
  image        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks             Stock[]
  stockMovements     StockMovement[]
  saleItems          SaleItem[]
  returnItems        ReturnItem[]
  stockLayers        StockLayer[]        @relation("VariantStockLayers")
  salesOrderItems    SalesOrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  packageItems       PackageItem[]
  shipmentItems      ShipmentItem[]
  batches            ItemBatch[]

  @@unique([productId, name])
  @@map("product_variants")
}

// Product Units
model ProductUnit {
  id        String   @id @default(cuid())
  productId String
  unitId    String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([productId, unitId])
  @@map("product_units")
}

// Stock Management
model Stock {
  id          String    @id @default(cuid())
  productId   String
  variantId   String?
  storeId     String
  warehouseId String?
  unitId      String?
  quantity    Float     @default(0)
  minStock    Float     @default(0)
  maxStock    Float?
  batchNumber String?
  expiryDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  unit      Unit?           @relation(fields: [unitId], references: [id])
  movements StockMovement[]

  @@unique([productId, variantId, storeId, warehouseId])
  @@index([productId, storeId, warehouseId])
  @@index([variantId])
  @@map("stocks")
}

// Stock Movement
model StockMovement {
  id           String              @id @default(cuid())
  productId    String
  variantId    String?
  storeId      String
  warehouseId  String?
  unitId       String?
  stockId      String?
  stockLayerId String?
  batchId      String?
  movementType MovementType
  quantity     Float
  unitCost     Float?
  totalCost    Float?
  reference    String?
  description  String?
  sourceType   MovementSourceType?
  sourceId     String?
  sourceItemId String?
  createdAt    DateTime            @default(now())

  // Relations
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse  Warehouse?      @relation(fields: [warehouseId], references: [id])
  unit       Unit?           @relation(fields: [unitId], references: [id])
  stock      Stock?          @relation(fields: [stockId], references: [id])
  stockLayer StockLayer?     @relation(fields: [stockLayerId], references: [id])
  batch      ItemBatch?      @relation(fields: [batchId], references: [id])

  @@index([productId, createdAt])
  @@index([storeId, warehouseId, createdAt])
  @@index([movementType, createdAt])
  @@index([stockLayerId])
  @@index([batchId])
  @@map("stock_movements")
}

enum MovementType {
  PURCHASE
  SALE
  SHIPMENT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  DAMAGE
  EXPIRED
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
}

enum MovementSourceType {
  PURCHASE
  SALE
  SHIPMENT
  ADJUSTMENT
  TRANSFER
  SALES_RETURN
  PURCHASE_RETURN
  OTHER
  PRODUCTION
}

enum StockAdjustmentType {
  QUANTITY
  VALUE
}

enum StockAdjustmentStatus {
  DRAFT
  FINAL
}

// GST Configuration
model GSTRate {
  id        String   @id @default(cuid())
  name      String
  rate      Float
  type      GSTType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products ProductGST[]

  @@map("gst_rates")
}

model ProductGST {
  id        String   @id @default(cuid())
  productId String
  gstId     String
  createdAt DateTime @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  gstRate GSTRate @relation(fields: [gstId], references: [id], onDelete: Cascade)

  @@unique([productId, gstId])
  @@map("product_gst")
}

enum GSTType {
  CGST
  SGST
  IGST
  CESS
}

// POS Session Management
model POSSession {
  id          String    @id @default(cuid())
  userId      String
  storeId     String
  openingDate DateTime  @default(now())
  closingDate DateTime?
  openingCash Float     @default(0)
  closingCash Float?
  isActive    Boolean   @default(true)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id])
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales    Sale[]
  payments Payment[]

  @@map("pos_sessions")
}

// Sales Management
model Sale {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  customerId    String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  sessionId     String
  storeId       String
  salesOrderId  String?
  subtotal      Float
  discount      Float         @default(0)
  taxAmount     Float         @default(0)
  totalAmount   Float
  paidAmount    Float
  dueAmount     Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  status        SaleStatus    @default(PENDING)
  stockDeducted Boolean       @default(false)
  notes         String?
  saleDate      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session    POSSession    @relation(fields: [sessionId], references: [id])
  customer   Customer?     @relation("customerSales", fields: [customerId], references: [id])
  items      SaleItem[]
  payments   Payment[]
  returns    SalesReturn[]
  salesOrder SalesOrder?   @relation("SalesOrderInvoices", fields: [salesOrderId], references: [id])

  @@index([storeId, saleDate])
  @@index([customerId, saleDate])
  @@index([salesOrderId])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  variantId  String?
  quantity   Float
  unitPrice  Float
  totalPrice Float
  discount   Float   @default(0)
  taxRate    Float   @default(0)
  taxAmount  Float   @default(0)
  batchId    String?

  // Relations
  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  batch   ItemBatch?      @relation(fields: [batchId], references: [id])

  @@map("sale_items")
}

model SalesOrder {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique
  customerId           String?
  storeId              String
  referenceNumber      String?
  orderDate            DateTime         @default(now())
  expectedShipmentDate DateTime?
  paymentTerms         String?
  deliveryMethod       String?
  salesperson          String?
  subtotal             Float
  discount             Float            @default(0)
  taxAmount            Float            @default(0)
  adjustment           Float            @default(0)
  totalAmount          Float
  status               SalesOrderStatus @default(DRAFT)
  notes                String?
  terms                String?
  emailRecipients      String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Relations
  customer  Customer?        @relation(fields: [customerId], references: [id])
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     SalesOrderItem[]
  invoices  Sale[]           @relation("SalesOrderInvoices")
  packages  Package[]
  shipments Shipment[]

  @@index([storeId, orderDate])
  @@index([customerId, orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id               String  @id @default(cuid())
  salesOrderId     String
  productId        String
  variantId        String?
  description      String?
  quantity         Float
  rate             Float
  discount         Float   @default(0)
  taxRate          Float   @default(0)
  taxAmount        Float   @default(0)
  totalAmount      Float
  packedQuantity   Float   @default(0)
  shippedQuantity  Float   @default(0)
  invoicedQuantity Float   @default(0)
  batchId          String?

  // Relations
  salesOrder    SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  batch         ItemBatch?      @relation(fields: [batchId], references: [id])
  packageItems  PackageItem[]
  shipmentItems ShipmentItem[]

  @@index([salesOrderId])
  @@map("sales_order_items")
}

// Payment Management
model Payment {
  id            String        @id @default(cuid())
  saleId        String?
  purchaseId    String?
  sessionId     String?
  amount        Float
  paymentMethod PaymentMethod
  reference     String?
  status        PaymentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  sale              Sale?             @relation(fields: [saleId], references: [id])
  purchase          Purchase?         @relation(fields: [purchaseId], references: [id])
  session           POSSession?       @relation(fields: [sessionId], references: [id])
  accountingEntries AccountingEntry[]

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  WALLET
  CREDIT
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum AccountingEntryType {
  PURCHASE_RECEIVE
  PURCHASE_BILL
  PURCHASE_PAYMENT
}

enum AccountingAccountCode {
  INVENTORY
  GRNI
  ACCOUNTS_PAYABLE
  CASH
  BANK
}

model AccountingEntry {
  id      String              @id @default(cuid())
  date    DateTime            @default(now())
  storeId String
  type    AccountingEntryType

  purchaseOrderId   String?
  purchaseReceiveId String?
  purchaseId        String?
  paymentId         String?

  debitAccount  AccountingAccountCode
  creditAccount AccountingAccountCode
  amount        Float
  currency      String                @default("INR")
  narration     String?
  meta          Json?
  createdAt     DateTime              @default(now())
  createdById   String?

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  purchaseReceive PurchaseReceive? @relation(fields: [purchaseReceiveId], references: [id])
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id])
  payment         Payment?         @relation(fields: [paymentId], references: [id])

  @@index([storeId, date])
  @@index([type, date])
  @@index([purchaseId])
  @@index([purchaseReceiveId])
  @@index([paymentId])
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
  RETURNED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  PARTIALLY_PAID
  PAID
  CLOSED
  CANCELLED
  PACKED
  SHIPPED
}

enum PackageStatus {
  NOT_SHIPPED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  DRAFT
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentType {
  MANUAL
  CARRIER
}

model Package {
  id            String        @id @default(cuid())
  packageNumber String        @unique
  salesOrderId  String
  storeId       String
  status        PackageStatus @default(NOT_SHIPPED)
  packageDate   DateTime      @default(now())
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  salesOrder SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  store      Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items      PackageItem[]
  shipments  Shipment[]

  @@index([salesOrderId])
  @@index([storeId, packageDate])
  @@map("packages")
}

model PackageItem {
  id               String   @id @default(cuid())
  packageId        String
  salesOrderItemId String
  productId        String
  variantId        String?
  quantity         Float
  shippedQuantity  Float    @default(0)
  createdAt        DateTime @default(now())

  // Relations
  package        Package         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem  @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  shipmentItems  ShipmentItem[]

  @@index([packageId])
  @@index([salesOrderItemId])
  @@map("package_items")
}

model Shipment {
  id               String         @id @default(cuid())
  shipmentNumber   String         @unique
  salesOrderId     String
  packageId        String
  storeId          String
  shipmentDate     DateTime       @default(now())
  carrier          String?
  trackingNumber   String?
  trackingUrl      String?
  shippingCharges  Float          @default(0)
  notes            String?
  delivered        Boolean        @default(false)
  deliveredAt      DateTime?
  sendNotification Boolean        @default(false)
  status           ShipmentStatus @default(SHIPPED)
  type             ShipmentType   @default(MANUAL)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  package    Package        @relation(fields: [packageId], references: [id])
  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items      ShipmentItem[]

  @@index([salesOrderId])
  @@index([packageId])
  @@index([storeId, shipmentDate])
  @@map("shipments")
}

model ShipmentItem {
  id               String   @id @default(cuid())
  shipmentId       String
  packageItemId    String
  salesOrderItemId String
  productId        String
  variantId        String?
  quantity         Float
  createdAt        DateTime @default(now())

  // Relations
  shipment       Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  packageItem    PackageItem     @relation(fields: [packageItemId], references: [id])
  salesOrderItem SalesOrderItem  @relation(fields: [salesOrderItemId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([shipmentId])
  @@index([salesOrderItemId])
  @@map("shipment_items")
}

// Purchase Management
model PurchaseOrder {
  id                  String              @id @default(cuid())
  orderNumber         String              @unique
  supplierId          String?
  storeId             String
  referenceNumber     String?
  orderDate           DateTime            @default(now())
  expectedReceiptDate DateTime?
  paymentTerms        String?
  deliveryMethod      String?
  buyer               String?
  subtotal            Float
  discount            Float               @default(0)
  taxAmount           Float               @default(0)
  adjustment          Float               @default(0)
  totalAmount         Float
  status              PurchaseOrderStatus @default(DRAFT)
  notes               String?
  terms               String?
  emailRecipients     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  supplier          Supplier?           @relation("supplierPurchaseOrders", fields: [supplierId], references: [id])
  store             Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items             PurchaseOrderItem[]
  purchaseReceives  PurchaseReceive[]
  accountingEntries AccountingEntry[]

  @@index([storeId, orderDate])
  @@index([supplierId, orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  productId        String
  variantId        String?
  description      String?
  quantity         Float
  rate             Float
  discount         Float   @default(0)
  taxRate          Float   @default(0)
  taxAmount        Float   @default(0)
  totalAmount      Float
  receivedQuantity Float   @default(0)
  billedQuantity   Float   @default(0)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product               @relation(fields: [productId], references: [id])
  variant       ProductVariant?       @relation(fields: [variantId], references: [id])
  receiveItems  PurchaseReceiveItem[]

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Purchase {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  supplierId    String?
  storeId       String
  subtotal      Float
  discount      Float          @default(0)
  taxAmount     Float          @default(0)
  totalAmount   Float
  paidAmount    Float
  dueAmount     Float          @default(0)
  paymentStatus PaymentStatus  @default(PENDING)
  status        PurchaseStatus @default(PENDING)
  expectedDate  DateTime?
  receivedDate  DateTime?
  notes         String?
  purchaseDate  DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier          Supplier?         @relation("supplierPurchases", fields: [supplierId], references: [id])
  items             PurchaseItem[]
  payments          Payment[]
  returns           PurchaseReturn[]
  accountingEntries AccountingEntry[]

  @@index([storeId, purchaseDate])
  @@index([supplierId, purchaseDate])
  @@map("purchases")
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Float
  unitPrice  Float
  totalPrice Float
  discount   Float   @default(0)
  taxRate    Float   @default(0)
  taxAmount  Float   @default(0)
  batchId    String?

  receivedQuantity Float @default(0)
  billedQuantity   Float @default(0)

  // Relations
  purchase Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product    @relation(fields: [productId], references: [id])
  batch    ItemBatch? @relation(fields: [batchId], references: [id])

  @@map("purchase_items")
}

enum PurchaseStatus {
  PENDING
  ORDERED
  RECEIVED
  CANCELLED
  RETURNED
}

enum PurchaseOrderStatus {
  DRAFT
  OPEN
  PARTIALLY_RECEIVED
  RECEIVED
  PARTIALLY_BILLED
  BILLED
  CANCELLED
  CLOSED
}

model PurchaseReceive {
  id              String                @id @default(cuid())
  receiveNumber   String                @unique
  purchaseOrderId String?
  supplierId      String?
  storeId         String
  subtotal        Float
  discount        Float                 @default(0)
  taxAmount       Float                 @default(0)
  totalAmount     Float
  status          PurchaseReceiveStatus @default(DRAFT)
  notes           String?
  receiveDate     DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  purchaseOrder     PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplier          Supplier?             @relation("supplierPurchaseReceives", fields: [supplierId], references: [id])
  store             Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items             PurchaseReceiveItem[]
  accountingEntries AccountingEntry[]

  @@index([storeId, receiveDate])
  @@index([purchaseOrderId, receiveDate])
  @@map("purchase_receives")
}

model PurchaseReceiveItem {
  id                  String    @id @default(cuid())
  purchaseReceiveId   String
  purchaseOrderItemId String?
  productId           String
  quantity            Float
  unitCost            Float
  totalPrice          Float
  discount            Float     @default(0)
  taxRate             Float     @default(0)
  taxAmount           Float     @default(0)
  batchId             String?
  batchNumber         String?
  batchMfgDate        DateTime?
  batchExpiryDate     DateTime?

  purchaseReceive   PurchaseReceive    @relation(fields: [purchaseReceiveId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  product           Product            @relation(fields: [productId], references: [id])
  batch             ItemBatch?         @relation(fields: [batchId], references: [id])

  @@index([purchaseReceiveId])
  @@map("purchase_receive_items")
}

enum PurchaseReceiveStatus {
  DRAFT
  POSTED
  CANCELLED
}

// Customer Management
enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum SupplierType {
  BUSINESS
  INDIVIDUAL
}

model Customer {
  id        String  @id @default(cuid())
  // Existing basic fields
  name      String
  email     String? @unique
  phone     String?
  address   String?
  gstNumber String?
  isActive  Boolean @default(true)

  // Extended customer profile
  type         CustomerType?
  salutation   String?
  firstName    String?
  lastName     String?
  displayName  String?
  companyName  String?
  mobile       String?
  language     String?
  pan          String?
  currency     String?
  paymentTerms String?
  allowPortal  Boolean       @default(false)
  remarks      String?

  // Relations
  addresses      CustomerAddress[]
  contactPersons CustomerContactPerson[]
  sales          Sale[]                  @relation("customerSales")
  salesOrders    SalesOrder[]
  activityLogs   CustomerActivityLog[]

  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  type       String // e.g. "BILLING" or "SHIPPING"
  attention  String?
  address1   String?
  address2   String?
  city       String?
  state      String?
  zipcode    String?
  country    String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model CustomerContactPerson {
  id         String   @id @default(cuid())
  customerId String
  salutation String?
  firstName  String
  lastName   String?
  email      String?
  workPhone  String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_contact_persons")
}

model CustomerActivityLog {
  id          String   @id @default(cuid())
  customerId  String
  type        String
  title       String?
  description String?
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("customer_activity_logs")
}

// Supplier Management
model Supplier {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type         SupplierType?
  salutation   String?
  firstName    String?
  lastName     String?
  displayName  String?
  companyName  String?
  mobile       String?
  language     String?
  pan          String?
  currency     String?
  paymentTerms String?
  remarks      String?

  // Relations
  purchases        Purchase[]              @relation("supplierPurchases")
  purchaseOrders   PurchaseOrder[]         @relation("supplierPurchaseOrders")
  purchaseReceives PurchaseReceive[]       @relation("supplierPurchaseReceives")
  products         Product[]               @relation("SupplierProducts")
  addresses        SupplierAddress[]
  contactPersons   SupplierContactPerson[]
  activityLogs     SupplierActivityLog[]

  @@map("suppliers")
}

model SupplierAddress {
  id         String   @id @default(cuid())
  supplierId String
  type       String
  attention  String?
  address1   String?
  address2   String?
  city       String?
  state      String?
  zipcode    String?
  country    String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_addresses")
}

model SupplierContactPerson {
  id         String   @id @default(cuid())
  supplierId String
  salutation String?
  firstName  String
  lastName   String?
  email      String?
  workPhone  String?
  mobile     String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_contact_persons")
}

model SupplierActivityLog {
  id          String   @id @default(cuid())
  supplierId  String
  type        String
  title       String?
  description String?
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt])
  @@map("supplier_activity_logs")
}

model Biller {
  id         String   @id @default(cuid())
  name       String
  company    String?
  email      String?  @unique
  phone      String?
  address    String?
  country    String?
  state      String?
  city       String?
  postalCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("billers")
}

model OrganizationProfile {
  id           String  @id @default(cuid())
  name         String
  industry     String?
  location     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zipCode      String
  websiteUrl   String?

  primaryContactName  String
  primaryContactEmail String
  primaryContactPhone String?

  baseCurrency      String
  fiscalYear        String
  language          String
  communicationLang String
  timezone          String
  dateFormat        String
  companyId         String?

  logoUrl String?

  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organization_profiles")
}

// Returns Management
model SalesReturn {
  id           String       @id @default(cuid())
  saleId       String
  returnNumber String       @unique
  reason       String?
  subtotal     Float
  discount     Float        @default(0)
  taxAmount    Float        @default(0)
  totalAmount  Float
  status       ReturnStatus @default(PENDING)
  notes        String?
  returnDate   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  sale  Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  items ReturnItem[]

  @@map("sales_returns")
}

model PurchaseReturn {
  id           String       @id @default(cuid())
  purchaseId   String
  returnNumber String       @unique
  reason       String?
  subtotal     Float
  discount     Float        @default(0)
  taxAmount    Float        @default(0)
  totalAmount  Float
  status       ReturnStatus @default(PENDING)
  notes        String?
  returnDate   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  purchase Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  items    ReturnItem[]

  @@map("purchase_returns")
}

model ReturnItem {
  id               String  @id @default(cuid())
  salesReturnId    String?
  purchaseReturnId String?
  productId        String
  variantId        String?
  quantity         Float
  unitPrice        Float
  totalPrice       Float

  // Relations
  salesReturn    SalesReturn?    @relation(fields: [salesReturnId], references: [id])
  purchaseReturn PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])
  product        Product         @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("return_items")
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model StockLayer {
  id           String              @id @default(cuid())
  productId    String
  variantId    String?
  storeId      String
  warehouseId  String?
  quantity     Float
  quantityUsed Float               @default(0)
  unitCost     Float
  sourceType   MovementSourceType?
  sourceId     String?
  createdAt    DateTime            @default(now())

  // Relations
  product   Product         @relation("ProductStockLayers", fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation("VariantStockLayers", fields: [variantId], references: [id])
  store     Store           @relation("StoreStockLayers", fields: [storeId], references: [id], onDelete: Cascade)
  warehouse Warehouse?      @relation("WarehouseStockLayers", fields: [warehouseId], references: [id])
  movements StockMovement[]

  @@index([productId, storeId, warehouseId, createdAt])
  @@map("stock_layers")
}

model StockAdjustment {
  id               String                @id @default(cuid())
  productId        String
  storeId          String
  adjustmentType   StockAdjustmentType
  quantityAdjusted Float
  costPerUnit      Float?
  oldQuantity      Float
  newQuantity      Float
  reason           String?
  referenceNumber  String?
  account          String?
  notes            String?
  status           StockAdjustmentStatus @default(DRAFT)
  createdBy        String
  createdAt        DateTime              @default(now())
  adjustmentDate   DateTime              @default(now())

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [createdBy], references: [id])

  @@index([productId, storeId, createdAt])
  @@map("stock_adjustments")
}

// Manufacturing - Bill of Materials
model BillOfMaterial {
  id                String @id @default(cuid())
  finishedProductId String
  rawMaterialId     String
  quantityRequired  Float
  unitId            String

  finishedProduct Product @relation("BOMParent", fields: [finishedProductId], references: [id], onDelete: Cascade)
  rawMaterial     Product @relation("BOMChild", fields: [rawMaterialId], references: [id])
  unit            Unit    @relation(fields: [unitId], references: [id])

  @@unique([finishedProductId, rawMaterialId])
  @@map("bill_of_materials")
}

// Manufacturing - Production Orders
model ProductionOrder {
  id                String           @id @default(cuid())
  finishedProductId String
  storeId           String
  quantityPlanned   Float
  quantityProduced  Float?
  status            ProductionStatus @default(DRAFT)
  notes             String?
  createdById       String
  createdAt         DateTime         @default(now())
  completedAt       DateTime?
  cancelledAt       DateTime?

  finishedProduct Product                 @relation(fields: [finishedProductId], references: [id])
  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation(fields: [createdById], references: [id])
  consumptions    ProductionConsumption[]

  @@index([finishedProductId, storeId, status, createdAt])
  @@map("production_orders")
}

enum ProductionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Manufacturing - Raw Material Consumption per Production Order
model ProductionConsumption {
  id                String @id @default(cuid())
  productionOrderId String
  rawMaterialId     String
  quantityUsed      Float

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  rawMaterial     Product         @relation(fields: [rawMaterialId], references: [id])

  @@index([productionOrderId])
  @@map("production_consumptions")
}

// ============================================
// RBAC System - Role-Based Access Control
// ============================================

// Role model - supports both system roles and custom roles
model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  displayName  String
  description  String?
  isSystemRole Boolean  @default(false) // System roles cannot be deleted
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users           User[]
  rolePermissions RolePermission[]
  auditLogs       AuditLog[]
  invitations     UserInvitation[]

  @@map("roles")
}

// Permission model - granular permissions for resources
model Permission {
  id          String   @id @default(cuid())
  resource    String // e.g., "sales", "purchase", "inventory"
  action      String // e.g., "read", "create", "update", "delete", "approve", "email", "export"
  description String?
  createdAt   DateTime @default(now())

  // Relations
  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@index([resource])
  @@map("permissions")
}

// RolePermission join table - many-to-many relationship
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// AuditLog model - track critical actions and changes
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  roleId      String?
  action      String // e.g., "role.created", "permission.updated", "user.role_assigned"
  resource    String? // e.g., "role", "user", "inventory"
  resourceId  String?
  description String?
  metadata    Json? // Additional context data
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])
  role Role? @relation(fields: [roleId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resource, resourceId])
  @@map("audit_logs")
}
